<UserControl x:Class="Runia.Ui.PagesMain.ServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             UseLayoutRounding="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Border Background="{DynamicResource ServerBackGround}" 
            CornerRadius="20" 
            Padding="15,30,8,15" 
            ClipToBounds="True">

        <Grid>
            <ScrollViewer Style="{StaticResource GooglePageScroll}" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ServersList" Padding="0" ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ServerCardStyle}" Margin="10" Cursor="Hand">
                                <!-- Фикс: используем MouseLeftButtonUp вместо PreviewDown -->
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseLeftButtonUp">
                                        <i:InvokeCommandAction Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                               CommandParameter="{Binding}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Шапка карточки -->
                                    <Border Grid.Row="0" CornerRadius="20,20,0,0" ClipToBounds="True">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <ImageBrush.ImageSource>
                                                    <Binding Path="DataContext.DisplayImageUrl" 
                                                             RelativeSource="{RelativeSource AncestorType=ContentPresenter}" 
                                                             FallbackValue="pack://application:,,,/Runia;component/assets/Images/news_default.png" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>

                                        <Border Background="#CC222222" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4" CornerRadius="0,20,0,10">
                                            <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Border>

                                    <!-- Инфо зона -->
                                    <Border Grid.Row="1" Padding="15,15,15,18">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" 
                                                       Style="{StaticResource HeaderText}"
                                                       FontSize="17" 
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding ShortDesc}" 
                                                       Style="{StaticResource HintText}" 
                                                       Margin="0,5,0,0" 
                                                       FontSize="12" 
                                                       TextWrapping="Wrap" 
                                                       MaxHeight="35"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <DockPanel LastChildFill="False" Margin="0,75,0,0">
                                                <!-- КНОПКА "ИГРАТЬ" -->
                                                <Button DockPanel.Dock="Left" 
                                                        Content="Играть" 
                                                        Style="{StaticResource PrimaryButtonStyle}" 
                                                        Padding="18,7" FontSize="15"
                                                        Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Focusable="False">
                                                    <!-- Важно: e.Handled = true, чтобы клик не ушел на саму карточку -->
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                                            <i:ChangePropertyAction PropertyName="Tag" Value="Handled"/>
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>
                                                </Button>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Online}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>