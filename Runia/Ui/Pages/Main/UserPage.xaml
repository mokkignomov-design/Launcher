<UserControl x:Class="Runia.Ui.PagesMain.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Runia.Ui.Pages.Controls"
             xmlns:profile="clr-namespace:Runia.Ui.Pages.Profile"
             mc:Ignorable="d" 
             d:DesignHeight="720" 
             d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,20,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,35" VerticalAlignment="Center">
            <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ" Style="{StaticResource HeaderText}" Opacity="0.5" FontSize="18"/>
            <TextBlock Text="/" Foreground="White" Opacity="0.5" Margin="5,0" FontSize="18" Height="27" Width="7"/>

            <ComboBox Style="{StaticResource PremiumComboBoxStyle}" 
                      SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" 
                      Width="250" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="Главная"/>
                <ComboBoxItem Content="Безопасность"/>
                <ComboBoxItem Content="История платежей"/>
            </ComboBox>
        </StackPanel>

        <TabControl Grid.Row="1" 
                    SelectedIndex="{Binding SelectedTabIndex}" 
                    Style="{StaticResource HiddenTabControlStyle}"
                    Background="Transparent"
                    BorderThickness="0">

            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,30,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="2" Rows="1" Margin="0,0,0,25">
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,12,0" MinHeight="210">
                                <Grid Margin="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="ВАШИ ДАННЫЕ" Style="{StaticResource HeaderText}" Opacity="0.8" HorizontalAlignment="Left" Margin="-31,-34,0,0"/>
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Username, StringFormat='Ник: {0}'}" Style="{StaticResource HintText}" Margin="0,4"/>
                                        <TextBlock Text="{Binding Email, StringFormat='Email: {0}'}" Style="{StaticResource HintText}" Margin="0,4"/>
                                        <TextBlock Text="{Binding RegDate, StringFormat='Регистрация: {0}'}" Style="{StaticResource HintText}" Margin="0,4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ModernCard}" Margin="12,0,0,0" MinHeight="210">
                                <Grid Margin="24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="БАЛАНС" Style="{StaticResource HeaderText}" Opacity="0.8" HorizontalAlignment="Left" Margin="-30,-34,0,0"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Balance}" Foreground="{StaticResource PrimaryBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <Button Grid.Row="2" Content="Пополнить" Style="{StaticResource PrimaryButtonStyle}" Height="42"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                            <Grid Margin="24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="СТАТИСТИКА" Style="{StaticResource HeaderText}" Opacity="0.8" HorizontalAlignment="Left" Margin="-28,-29,0,0"/>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Время в игре: 275 ч." Style="{StaticResource HintText}" Margin="0,4"/>
                                    <TextBlock Text="Любимый сервер: Mini Games" Style="{StaticResource HintText}" Margin="0,4"/>
                                    <TextBlock Text="Друзей: 12" Style="{StaticResource HintText}" Margin="0,4"/>
                                    <TextBlock Text="Уровень: 4" Style="{StaticResource HintText}" Margin="0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource CharacterCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="СКИН И ПЛАЩ" Style="{StaticResource HeaderText}" Margin="14,15,0,0" HorizontalAlignment="Left"/>
                            <controls:SkinView Grid.Row="1" x:Name="PlayerPreview" SkinPath="{Binding SkinPath}" Margin="20"/>
                            <Button Grid.Row="2" Content="Загрузить скин" Command="{Binding LoadSkinCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="48" Margin="25"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <profile:SecurityUserPage/>
            </TabItem>

            <TabItem>
                <profile:PaymentHistoryUserPage/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>