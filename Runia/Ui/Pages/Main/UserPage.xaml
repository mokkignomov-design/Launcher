<UserControl x:Class="Runia.Ui.PagesMain.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Runia.Ui.Pages.Controls"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER С ВЫБОРОМ РАЗДЕЛА -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
            <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ / " Style="{StaticResource HeaderText}" VerticalAlignment="Center" Opacity="0.5"/>
            <ComboBox Style="{StaticResource PremiumComboBoxStyle}" SelectedIndex="0">
                <ComboBoxItem Content="Главная"/>
                <ComboBoxItem Content="Безопасность"/>
                <ComboBoxItem Content="История платежей"/>
            </ComboBox>
        </StackPanel>

        <!-- DASHBOARD -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Левая колонка фиксированная -->
                <ColumnDefinition Width="*"/>
                <!-- Правая тянется -->
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <!-- ДАННЫЕ -->
                    <Border Style="{StaticResource ModernCard}" Width="{StaticResource UserDataCardWidth}">
                        <StackPanel>
                            <TextBlock Text="ВАШИ ДАННЫЕ" Style="{StaticResource HeaderText}"/>
                            <Grid Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Ник: deadsound" Style="{StaticResource HintText}" Margin="0,2"/>
                                    <TextBlock Text="Email: g******2@bk.ru" Style="{StaticResource HintText}" Margin="0,2"/>
                                    <TextBlock Text="Регистрация: 01.02.2024" Style="{StaticResource HintText}" Margin="0,2"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- БАЛАНС -->
                    <Border Style="{StaticResource ModernCard}" Width="{StaticResource UserBalanceCardWidth}">
                        <StackPanel>
                            <TextBlock Text="БАЛАНС" Style="{StaticResource HeaderText}"/>
                            <TextBlock Text="25 791.00 AP" Foreground="{StaticResource PrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,10"/>
                            <Button Content="Пополнить" Style="{StaticResource PrimaryButtonStyle}" Height="35"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- СТАТИСТИКА -->
                <Border Style="{StaticResource ModernCard}" Width="675" Height="350" Margin="0,15,0,0">
                    <StackPanel>
                        <TextBlock Text="СТАТИСТИКА" Style="{StaticResource HeaderText}"/>
                        <UniformGrid Columns="2" Margin="0,20">
                            <StackPanel>
                                <TextBlock Text="Время в игре: 275 ч." Style="{StaticResource HintText}" Margin="0,5"/>
                                <TextBlock Text="Любимый сервер: Mini Games" Style="{StaticResource HintText}" Margin="0,5"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Друзей: 12" Style="{StaticResource HintText}" Margin="0,5"/>
                                <TextBlock Text="Уровень: 4" Style="{StaticResource HintText}" Margin="0,5"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- СКИН И ПЛАЩ -->
            <Border Grid.Column="1" Style="{StaticResource CharacterCardStyle}" Margin="15,0,0,15">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Margin="20,20,20,0">
                        <TextBlock Text="СКИН И ПЛАЩ" Style="{StaticResource HeaderText}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Источник скина:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding SkinUrl, UpdateSourceTrigger=PropertyChanged}" Padding="5" Width="300"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- SkinView Рендерер -->
                    <controls:SkinView x:Name="PlayerPreview" SkinSource="{Binding SkinSource}" Margin="0,80,0,80"/>

                    <StackPanel VerticalAlignment="Bottom" Margin="20">
                        <UniformGrid Columns="2">
                            <Button Content="Загрузить из интернета" Command="{Binding LoadFromUrlCommand}" Style="{StaticResource GhostButtonStyle}" Margin="5"/>
                            <Button Content="Открыть файл" Command="{Binding LoadFromFileCommand}" Style="{StaticResource GhostButtonStyle}" Margin="5"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>