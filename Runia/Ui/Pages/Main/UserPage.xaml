<UserControl x:Class="Runia.Ui.PagesMain.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Runia.Ui.Pages.Controls"
             xmlns:profile="clr-namespace:Runia.Ui.Pages.Profile"
             mc:Ignorable="d" 
             d:DesignHeight="720" 
             d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HiddenTabControlStyle" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,-30,0,30" VerticalAlignment="Center">
            <TextBlock Text="ЛИЧНЫЙ КАБИНЕТ" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource GrayBrush}"/>
            <TextBlock Text="/" Foreground="{DynamicResource GrayBrush}" Margin="15,0" FontSize="14" VerticalAlignment="Center" Opacity="0.9"/>

            <ComboBox Style="{StaticResource PremiumComboBoxStyle}" 
                      SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" 
                      Width="220" VerticalAlignment="Center">
                <ComboBoxItem Content="Главная"/>
                <ComboBoxItem Content="Безопасность"/>
                <ComboBoxItem Content="История платежей"/>
            </ComboBox>
        </StackPanel>

        <TabControl Grid.Row="1" 
                    SelectedIndex="{Binding SelectedTabIndex}" 
                    Style="{StaticResource HiddenTabControlStyle}"
                    Background="Transparent"
                    BorderThickness="0">

            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,25">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Ваши Данные" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GrayBrush}" Margin="5,0,0,10"/>
                                <Border Style="{StaticResource ModernCard}" MinHeight="160">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Никнейм" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Email" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource HeaderText}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Дата регистрации" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding RegDate}" Style="{StaticResource HeaderText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Баланс" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GrayBrush}" Margin="5,0,0,10"/>
                                <Border Style="{StaticResource ModernCard}" MinHeight="175">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="Текущий баланс" Style="{DynamicResource HeaderText}"  FontSize="14"/>
                                            <TextBlock Text="Доступно для покупок" Style="{DynamicResource HintText}"/>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Balance, StringFormat='{}{0} ₽'}" 
                                                       Foreground="{DynamicResource PrimaryBrush}" 
                                                       FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Button Content="Скоро!" Style="{DynamicResource PrimaryButtonStyle}" Height="40" HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Игровая Статистика" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource GrayBrush}" Margin="5,0,0,10"/>
                        <Border Style="{DynamicResource ModernCard}">
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Время в игре" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="{Binding PlayedHours, StringFormat='{}{0} ч.'}" Style="{StaticResource HeaderText}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Роль" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="{Binding Role}" Style="{StaticResource HeaderText}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Убийств" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="{Binding Kills}" Style="{StaticResource HeaderText}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Смертей" Style="{StaticResource HintText}"/>
                                    <TextBlock Text="{Binding Deaths}" Style="{StaticResource HeaderText}" FontSize="16"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ВИЗУАЛИЗАЦИЯ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource GrayBrush}" Margin="5,0,0,10"/>
                        <Border Style="{DynamicResource CharacterCardStyle}" Height="500" Width="350">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <controls:SkinView x:Name="PlayerPreview" SkinPath="{Binding SkinPath}" Margin="-20"/>

                                <StackPanel Grid.Row="1" Margin="20">
                                    <Button Content="ИЗМЕНИТЬ СКИН" 
                                            Command="{Binding LoadSkinCommand}" 
                                            Style="{DynamicResource PrimaryButtonStyle}" 
                                            Height="45" Margin="0,0,0,10"/>
                               
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem>
                <profile:SecurityUserPage/>
            </TabItem>
            <TabItem>
                <profile:PaymentHistoryUserPage/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>