<UserControl x:Class="Runia.Ui.PagesMain.ServerDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Runia.ViewModels.Main"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="20" Margin="10" ClipToBounds="True">
        <ScrollViewer Style="{StaticResource GooglePageScroll}" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,30,30,40">

                <Grid Margin="0,0,0,25">
                    <Border Height="380" CornerRadius="20" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding DisplayImageUrl}" 
                                        Stretch="UniformToFill" />
                        </Border.Background>

                    </Border>

                    <Button Command="{Binding BackCommand}"
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Top" 
                            Margin="20"
                            Style="{StaticResource CircleBackButtonStyle}">
                        <Path Data="M19,12H5M5,12L12,5M5,12L12,19" 
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                              StrokeThickness="2" 
                              Stretch="Uniform" 
                              Width="14" Height="14"/>
                    </Button>

                    <TextBlock Text="{Binding ServerName}" 
                               FontSize="42" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="30,0,30,25"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ONLINE" Foreground="#4CAF50" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding PlayerCount, StringFormat=': {0} игроков'}" 
                                   Foreground="#4CAF50" 
                                   FontWeight="Bold" 
                                   FontSize="16"/>
                    </StackPanel>

                    <Separator Background="#33FFFFFF" Margin="0,0,0,25"/>

                    <TextBlock Text="ОПИСАНИЕ" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource GrayBrush}" 
                               Margin="0,0,0,15"/>

                    <!-- Короткое описание (затемненным светло-серым) -->
                    <TextBlock Text="{Binding ServerDescription}" 
                               FontSize="18" 
                               Foreground="#CCCCCC" 
                               TextWrapping="Wrap" 
                               LineHeight="28" 
                               TextAlignment="Justify"
                               Margin="0,0,0,12"/>

                    <!-- Полное описание (белым, чуть ниже) -->
                    <TextBlock Text="{Binding FullDescription}" 
                               FontSize="16" 
                               Foreground="White" 
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" 
                               LineHeight="26" 
                               TextAlignment="Justify"
                               Margin="0,0,0,20"/>

                    <!-- Список модов, генерируется из коллекции Mods -->
                    <TextBlock Text="МОДЫ" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource GrayBrush}" 
                               Margin="0,10,0,8"/>

                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="8" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding .}" Foreground="White" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{Binding Progress, FallbackValue='ИГРАТЬ'}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Height="65" Width="250" 
                            FontSize="20" FontWeight="Bold"
                            HorizontalAlignment="Left"
                            Command="{Binding LaunchCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>