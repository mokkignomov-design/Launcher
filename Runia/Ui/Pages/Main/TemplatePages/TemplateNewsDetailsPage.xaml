<UserControl x:Class="Runia.Ui.PagesMain.NewsDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Border Background="#1E1E1E" CornerRadius="20" Margin="10" ClipToBounds="True">
        <ScrollViewer Style="{StaticResource GooglePageScroll}" 
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30,30,30,40">
                <Grid Margin="0,0,0,25">
                    <Border Height="380" CornerRadius="20" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill">
                            <ImageBrush.ImageSource>
                                    <Binding Path="SelectedNews.DisplayImageUrl" FallbackValue="pack://application:,,,/Runia;component/assets/Images/news_default.png" />
                                </ImageBrush.ImageSource>
                            </ImageBrush>
                        </Border.Background>
                    </Border>
                    <Button Style="{StaticResource CircleBackButtonStyle}" 
            Command="{Binding GoBackCommand}"
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Margin="20">
                        <Path Data="M19,12H5M5,12L12,5M5,12L12,19" 
              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
              StrokeThickness="2" 
              Stretch="Uniform" 
              Width="14" Height="14"/>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding SelectedNews.Title}" 
                           FontSize="32" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>

                <TextBlock Text="{Binding SelectedNews.Date}" 
                           Foreground="#888888" Margin="0,10,0,25" FontSize="14"/>

                <TextBlock Text="{Binding SelectedNews.FullContent}" 
                           FontSize="17" Foreground="#CCCCCC" TextWrapping="Wrap" 
                           LineHeight="26" TextAlignment="Justify"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>