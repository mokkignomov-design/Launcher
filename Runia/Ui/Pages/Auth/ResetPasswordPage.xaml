<UserControl x:Class="Runia.Ui.PagesUser.ResetPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Runia.Ui.PagesUser"
             xmlns:behaviors="clr-namespace:Runia.Services.Core.Infrastructure.WPF.Behaviors"
             xmlns:vm="clr-namespace:Runia.ViewModels.Auth"
             mc:Ignorable="d"
             Background="Transparent" Height="430" Width="330">
    <StackPanel Margin="20" VerticalAlignment="Center" Background="Transparent">
        <TextBlock x:Name="TitleText"
     Text="Подтверждение кода"
     TextWrapping="Wrap"
     TextAlignment="Center"         
     FontSize="30"
     FontFamily="/assets/Fonts/#Gabriela"
     Foreground="{DynamicResource PrimaryBrush}"
     HorizontalAlignment="Center"
     Margin="0,0,0,15"/>

        <TextBlock x:Name="InstructionText"
             Text="Введите код из письма и установите новый пароль"
             Foreground="{DynamicResource TextBrush}"
             TextWrapping="Wrap"
             TextAlignment="Center"
             Margin="0,0,0,25"
             FontSize="14"/>

        <!-- Код подтверждения -->
        <Border Margin="0,0,0,10" CornerRadius="8"
              Background="{DynamicResource InputPanelBackgroundBrush}"
              BorderBrush="{DynamicResource InputPanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔑" FontSize="16" VerticalAlignment="Center" Margin="10,0,5,0"
                     Foreground="{DynamicResource PlaceholderBrush}"/>
                <TextBox x:Name="CodeText" Grid.Column="1"
                   Background="Transparent" Foreground="{DynamicResource TextBrush}"
                   BorderThickness="0" Padding="5,9,10,9"
                   VerticalContentAlignment="Center"
                   Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                   MaxLength="6" FontSize="20" TextAlignment="Center" Margin="-35,0,0,0"/>
            </Grid>
        </Border>

        <!-- Новый пароль -->
        <Border Margin="0,0,0,10" CornerRadius="8"
              Background="{DynamicResource InputPanelBackgroundBrush}"
              BorderBrush="{DynamicResource InputPanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="10,0,5,0"
                     Foreground="{DynamicResource PlaceholderBrush}"/>
                <PasswordBox x:Name="NewPasswordBox" Grid.Column="1"
                           Background="Transparent" Foreground="{DynamicResource TextBrush}"
                           BorderThickness="0" Padding="5,9,10,9"
                           VerticalContentAlignment="Center"
                           behaviors:PasswordBoxAttachmentBehavior.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="NewPasswordPlaceholder" Grid.Column="1"
                     Text="Новый пароль"
                     Foreground="{DynamicResource PlaceholderBrush}"
                     VerticalAlignment="Center" Margin="5,0,10,0"
                     Visibility="Visible" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Подтверждение пароля -->
        <Border Margin="0,0,0,20" CornerRadius="8"
              Background="{DynamicResource InputPanelBackgroundBrush}"
              BorderBrush="{DynamicResource InputPanelBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="10,0,5,0"
                     Foreground="{DynamicResource PlaceholderBrush}"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="1"
                           Background="Transparent" Foreground="{DynamicResource TextBrush}"
                           BorderThickness="0" Padding="5,9,10,9"
                           VerticalContentAlignment="Center"
                           behaviors:PasswordBoxAttachmentBehavior.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock x:Name="ConfirmPasswordPlaceholder" Grid.Column="1"
                     Text="Повторите пароль"
                     Foreground="{DynamicResource PlaceholderBrush}"
                     VerticalAlignment="Center" Margin="5,0,10,0"
                     Visibility="Visible" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Button Content="Подтвердить"
              Style="{DynamicResource PrimaryButtonStyle}"
              Command="{Binding ConfirmResetCommand}"
              Height="39" Width="276"
              Focusable="False"/>

        <!-- Вернуться -->
        <Button HorizontalAlignment="Center" Margin="0,15,0,0"
                Background="Transparent" BorderThickness="0" Cursor="Hand"
                Command="{Binding BackToForgotPasswordCommand}">
            <TextBlock Text="Вернуться" Foreground="{DynamicResource SecondaryBrush}"/>
        </Button>

        <ProgressBar x:Name="LoadingBar"
               IsIndeterminate="True"
               Height="4"
               Margin="0,15,0,0"
               Visibility="Collapsed"
               Width="276"/>
    </StackPanel>
</UserControl>
