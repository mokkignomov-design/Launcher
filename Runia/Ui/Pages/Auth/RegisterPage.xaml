<UserControl x:Class="Runia.Ui.PagesUser.RegisterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:Runia.Services.Core.Infrastructure.WPF.Behaviors"
             xmlns:local="clr-namespace:Runia.Ui.PagesUser"
             xmlns:vm="clr-namespace:Runia.ViewModels.Auth"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450"
             Background="Transparent">

    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="Регистрация" 
                   FontSize="40"
                   FontFamily="/assets/Fonts/#Gabriela"
                   Foreground="{DynamicResource PrimaryBrush}"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>

        <Border Margin="0,0,0,10" CornerRadius="8"
                Background="{DynamicResource InputPanelBackgroundBrush}"
                BorderBrush="{DynamicResource InputPanelBorderBrush}" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="12,0,8,0"
                           Foreground="{DynamicResource PlaceholderBrush}"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="UsernameText" 
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             Padding="0,10,10,10" 
                             VerticalContentAlignment="Center"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Имя пользователя" IsHitTestVisible="False"
                               Foreground="{DynamicResource PlaceholderBrush}" 
                               VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=UsernameText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <Border Margin="0,0,0,10" CornerRadius="8"
                Background="{DynamicResource InputPanelBackgroundBrush}"
                BorderBrush="{DynamicResource InputPanelBorderBrush}" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="✉" FontSize="16" VerticalAlignment="Center" Margin="12,0,8,0"
                           Foreground="{DynamicResource PlaceholderBrush}"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="EmailText" 
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             Padding="0,10,10,10" 
                             VerticalContentAlignment="Center"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Email" IsHitTestVisible="False"
                               Foreground="{DynamicResource PlaceholderBrush}" 
                               VerticalAlignment="Center" Margin="2,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=EmailText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Margin="0,0,0,20">
            <Border CornerRadius="8"
                    Background="{DynamicResource InputPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource InputPanelBorderBrush}" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="12,0,8,0"
                               Foreground="{DynamicResource PlaceholderBrush}"/>

                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="PassBox" 
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderThickness="0"
                                     Padding="0,10,10,10"
                                     VerticalContentAlignment="Center"
                                     behaviors:PasswordBoxAttachmentBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Придумайте пароль" 
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource PlaceholderBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Password}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Password}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock FontSize="10" Margin="5,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Мин. длина пароля — 6 символов"/>
                        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordLengthOk}" Value="True">
                                <Setter Property="Text" Value="Пароль подходит ✓"/>
                                <Setter Property="Foreground" Value="#4CAF50"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPasswordLengthOk}" Value="False"/>
                                    <Condition Binding="{Binding Password.Length, FallbackValue=0, TargetNullValue=0}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPasswordLengthOk}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="IndianRed"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Password}" Value="">
                                <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Button Content="Зарегистрироваться"
                Style="{DynamicResource PrimaryButtonStyle}"
                Command="{Binding RegisterCommand}"
                Height="39" 
                Width="276"/>

        <Button HorizontalAlignment="Center" 
                Margin="0,15,0,0"
                Style="{DynamicResource TransparentButtonStyle}"
                Command="{Binding BackToLoginCommand}">
            <TextBlock Text="Вернуться ко входу" Foreground="{DynamicResource SecondaryBrush}"/>
        </Button>
    </StackPanel>
</UserControl>