<UserControl x:Class="Runia.Ui.PagesUser.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:Runia.Services.Core.Infrastructure.WPF.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="390"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <StackPanel Margin="20" VerticalAlignment="Center">

            <TextBlock Text="Runia" FontSize="60"
                       FontFamily="/assets/Fonts/#Gabriela"
                       Foreground="{DynamicResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>

            <Border Margin="0,10,0,0" CornerRadius="8"
                    Background="{DynamicResource InputPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource InputPanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center" Margin="12,0,8,0"
                               Foreground="{DynamicResource PlaceholderBrush}"/>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="UsernameText" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                 Padding="0,10,10,10" VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Имя пользователя" IsHitTestVisible="False"
                                   Foreground="{DynamicResource PlaceholderBrush}" 
                                   VerticalAlignment="Center" Margin="2,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0" CornerRadius="8"
                    Background="{DynamicResource InputPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource InputPanelBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔒" FontSize="16" VerticalAlignment="Center" Margin="12,0,8,0"
                               Foreground="{DynamicResource PlaceholderBrush}"/>

                    <Grid Grid.Column="1">
                        <PasswordBox x:Name="PasswordBox" Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                     Padding="0,10,10,10" VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource PrimaryBrush}"
                                     behaviors:PasswordBoxAttachmentBehavior.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock x:Name="PasswordPlaceholder" Text="Пароль" IsHitTestVisible="False"
                                   Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center"
                                   Margin="2,0,10,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Password}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Password}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,15,0,0">
                <CheckBox Content="Запомнить меня"
                          Foreground="{DynamicResource TextBrush}"
                          IsChecked="{Binding RememberMe, Mode=TwoWay}"
                          Style="{DynamicResource CheckBoxStyle}"/>

                <Button HorizontalAlignment="Right" 
                        Style="{StaticResource TransparentButtonStyle}"
                        Command="{Binding ForgotPasswordCommand}">
                    <TextBlock Text="Забыли пароль?" Foreground="{DynamicResource SecondaryBrush}"/>
                </Button>
            </Grid>

            <Button Content="Авторизоваться" 
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Command="{Binding LoginCommand}" 
                    Margin="0,25,0,0" Height="40" Width="280"/>

            <Button Content="DEBUG: Войти без сервера" 
                    Style="{StaticResource TransparentButtonStyle}"
                    Foreground="Gray" FontSize="10" Margin="0,10,0,0"
                    Command="{Binding LoginDebugCommand}"/>

            <Button HorizontalAlignment="Center" Margin="0,20,0,0"
                    Style="{StaticResource TransparentButtonStyle}"
                    Command="{Binding RegisterCommand}">
                <TextBlock Text="Создать аккаунт" Foreground="{DynamicResource SecondaryBrush}" 
                           TextDecorations="Underline"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>