<UserControl x:Class="Runia.Ui.PagesUser.ForgotPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450"
             Background="Transparent">

    <StackPanel VerticalAlignment="Center" Margin="20">
        <TextBlock Text="Восстановление"
                   FontSize="30" 
                   FontFamily="/assets/Fonts/#Gabriela"
                   Foreground="{DynamicResource PrimaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>

        <TextBlock Text="Доступа"
                   FontSize="25"
                   FontFamily="/assets/Fonts/#Gabriela"
                   Foreground="{DynamicResource SecondaryBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <Border Background="{DynamicResource InputPanelBackgroundBrush}"
                BorderBrush="{DynamicResource InputPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Width="280"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="✉" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PlaceholderBrush}"/>

                <TextBox Grid.Column="1" 
                         Style="{DynamicResource ModernTextBox}"
                         Tag="Введите вашу почту"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Button Content="ОТПРАВИТЬ КОД"
                Command="{Binding ResetPasswordCommand}"
                Style="{DynamicResource PrimaryButtonStyle}"
                Width="280" Height="45"/>

        <Button Command="{Binding BackToLoginCommand}"
                Style="{DynamicResource TextButtonStyle}"
                Content="Вернуться ко входу"
                Margin="0,25,0,0"
                HorizontalAlignment="Center"/>

        <ProgressBar IsIndeterminate="True"
                     Height="4"
                     Margin="0,20,0,0"
                     Width="200"
                     Foreground="{DynamicResource PrimaryBrush}">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
    </StackPanel>
</UserControl>