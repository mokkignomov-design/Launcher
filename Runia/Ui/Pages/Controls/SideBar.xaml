<UserControl x:Class="Runia.Ui.PagesMain.SideBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" x:Name="Root">

    <UserControl.Resources>
            <Style x:Key="NavEmojiStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource SidebarIconBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavRadioStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource GrayBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ActiveIndicator" 
                                    Background="{DynamicResource PrimaryBrush}" 
                                    Width="4" CornerRadius="0,2,2,0" 
                                    Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="{DynamicResource NavPanelBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource LoadingPanelBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="SidebarBorder" 
            Background="{DynamicResource SidebarBackgroundBrush}" 
            CornerRadius="20" 
            Width="70" 
            HorizontalAlignment="Left" 
            Margin="10,15,0,15"
            BorderBrush="#1AFFFFFF"
            BorderThickness="1">

        <Grid x:Name="SidebarPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel x:Name="LogoCenterPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="RTextBlock" Text="R" FontSize="36" FontWeight="Bold" FontFamily="/assets/Fonts/#Gabriela" 
                               Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UniaTextBlock" Text="unia" FontSize="36" FontWeight="Bold" FontFamily="/assets/Fonts/#Gabriela" 
                               VerticalAlignment="Center" Opacity="0" Width="0"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
            </Grid>

            <RadioButton x:Name="ProfileRadio" Grid.Row="1" Style="{StaticResource NavRadioStyle}" GroupName="SidebarGroup" Margin="0,0,0,20" IsChecked="{Binding IsProfileSelected, Mode=TwoWay}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction Command="{Binding GoProfileCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Grid Width="230" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                        <TextBlock Text="🕵️" Style="{StaticResource NavEmojiStyle}"/>
                        <TextBlock x:Name="ProfileLabel" Text="Личный кабинет" Style="{StaticResource NavTextStyle}" Opacity="0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <RadioButton x:Name="HomeRadio" Style="{StaticResource NavRadioStyle}" GroupName="SidebarGroup" IsChecked="{Binding IsHomeSelected, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding GoHomeCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid Width="230" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                            <TextBlock Text="🏡" Style="{StaticResource NavEmojiStyle}"/>
                            <TextBlock x:Name="HomeLabel" Text="Новости" Style="{StaticResource NavTextStyle}" Opacity="0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="ServersRadio" Style="{StaticResource NavRadioStyle}" GroupName="SidebarGroup">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding GoServersCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid Width="230" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                            <TextBlock Text="🖥" Style="{StaticResource NavEmojiStyle}"/>
                            <TextBlock x:Name="ServersLabel" Text="Серверы" Style="{StaticResource NavTextStyle}" Opacity="0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="SettingsRadio" Style="{StaticResource NavRadioStyle}" GroupName="SidebarGroup">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Checked">
                            <i:InvokeCommandAction Command="{Binding GoSettingsCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Grid Width="230" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                            <TextBlock Text="⚙️" Style="{StaticResource NavEmojiStyle}"/>
                            <TextBlock x:Name="SettingsLabel" Text="Настройки" Style="{StaticResource NavTextStyle}" Opacity="0"/>
                        </StackPanel>
                    </Grid>
                </RadioButton>
            </StackPanel>

            <RadioButton x:Name="LogoutRadio" Grid.Row="3" Style="{StaticResource NavRadioStyle}" GroupName="SidebarGroup">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction Command="{Binding LogoutCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <Grid Width="230" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                        <TextBlock Text="🚪" Style="{StaticResource NavEmojiStyle}"/>
                        <TextBlock x:Name="LogoutLabel" Text="Выйти из аккаунта" Style="{StaticResource NavTextStyle}" Opacity="0"/>
                    </StackPanel>
                </Grid>
            </RadioButton>
        </Grid>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SidebarBorder" Storyboard.TargetProperty="Width" To="230" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="UniaTextBlock" Storyboard.TargetProperty="Width" To="80" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="UniaTextBlock" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" BeginTime="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="ProfileLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="HomeLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="ServersLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="SettingsLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="LogoutLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SidebarBorder" Storyboard.TargetProperty="Width" To="70" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="UniaTextBlock" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="UniaTextBlock" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="ProfileLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="HomeLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="ServersLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="SettingsLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                    <DoubleAnimation Storyboard.TargetName="LogoutLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>