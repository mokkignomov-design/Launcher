<UserControl x:Class="Runia.Ui.Pages.Controls.NotificationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignWidth="400" Height="98">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Показываем, только когда IsLaunching = true -->
    <Grid Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}">
        <Border Background="#EE1A1A1A" 
                CornerRadius="20" 
                Padding="20,12" 
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="0,0,0,40">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <!-- Исправленная иконка облака -->
                <Path Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z" 
                      Fill="{StaticResource PrimaryBrush}" 
                      Width="20" Height="20" 
                      Stretch="Uniform"
                      VerticalAlignment="Center" 
                      Margin="0,0,15,0"/>

                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding CurrentStatus, FallbackValue='ЗАГРУЗКА...'}" 
                               Foreground="White" 
                               FontWeight="Bold" 
                               FontSize="13"/>
                    <TextBlock Text="{Binding CurrentFileName, FallbackValue='Синхронизация файлов'}" 
                               Foreground="#888888" 
                               FontSize="11"
                               MaxWidth="250"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Крутилка (замени на свою, если есть стиль CircularProgressStyle) -->
                <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <Ellipse Stroke="#33FFFFFF" StrokeThickness="2"/>
                    <ProgressBar Style="{StaticResource GoogleProgressStyle}" 
                                 IsIndeterminate="True" 
                                 Background="Transparent"
                                 BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>