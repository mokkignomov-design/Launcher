<UserControl x:Class="Runia.Ui.Pages.Profile.PaymentHistoryUserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Runia.Ui.Pages.Profile"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="30,20,30,30">
            <TextBlock Text="ИСТОРИЯ ПЛАТЕЖЕЙ" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,30"/>

            <StackPanel HorizontalAlignment="Left" Height="300" Width="500" Margin="10,0,0,0">
                <TextBlock Text="В РАЗРАБОТКЕ" Style="{StaticResource HintText}" Margin="0,10" FontSize="16" FontWeight="Bold"/>
             
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
