<Window x:Class="Runia.Ui.Windows.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="Auto" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Border Background="{DynamicResource InputPanelBackgroundBrush}" 
            BorderBrush="{DynamicResource PrimaryBrush}" 
            BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleTxt" 
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryBrush}" 
                       Margin="0,0,0,10" 
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="MessageTxt" 
                       FontSize="14" 
                       Foreground="{DynamicResource TextBrush}" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <Button Content="Понятно" 
                    Style="{DynamicResource PrimaryButtonStyle}" 
                    Width="120" Height="35"
                    Click="CloseClick"/>
        </StackPanel>
    </Border>
</Window>