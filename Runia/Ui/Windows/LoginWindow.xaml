<Window x:Class="Runia.Ui.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Runia.Ui.Windows"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
       mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        
             Title="LoginWindow" Height="490" Width="800">
        <Grid Background="Transparent">
            <Border x:Name="MainBorder" CornerRadius="40" Background="{DynamicResource BackgroundBrush}">
            <Grid Cursor="">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="LoginContentHost" Grid.Column="0" Margin="40" VerticalAlignment="Center" Content="{Binding CurrentPageViewModel}" Focusable="False" IsTabStop="False"/>
                <Grid Grid.Column="1" Background="Transparent">
                        <Border CornerRadius="0,40,40,0" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource LoginBackgroundImage}"
                     Stretch="UniformToFill"
                     AlignmentX="Right"/>
                        </Border.Background>
                        <Button Content="✕"
     HorizontalAlignment="Right" VerticalAlignment="Top" 
     Margin="0,24,28,0" Width="30" Height="30"
     Background="Transparent"
     FontSize="16" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <i:InvokeCommandAction Command="{Binding CloseCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}" 
                                   CommandParameter="{Binding ElementName=LoginContentHost}"/>
        </i:EventTrigger>

        <i:EventTrigger EventName="MouseLeftButtonDown">
            <i:InvokeCommandAction Command="{Binding DragMoveCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>