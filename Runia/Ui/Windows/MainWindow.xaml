<Window x:Class="Runia.Ui.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Runia.Ui.Pages.Controls"

        
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Title="Runia Launcher" Height="700" Width="1200"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="30"
            ClipToBounds="True"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <!-- Window control buttons (minimize and close) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" Panel.ZIndex="1000"/>
            <Image x:Name="BackgroundImage" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="30"/>
                </Image.Effect>
            </Image>

            <Grid>
                <Grid x:Name="MainContentWrapper" Margin="100,20,20,20">
                    <ContentControl x:Name="MainContentHost" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        Content="{Binding}"/>
                </Grid>

                <ContentControl x:Name="SidebarHost" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Stretch" 
                    Margin="8,5,0,5" 
                    Panel.ZIndex="100" 
                    IsHitTestVisible="True"/>
                <Button
                            Background="Transparent" FontSize="16" Cursor="Hand" BorderThickness="0"
                            Command="{Binding CloseCommand}" Margin="1159,0,7,666">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="✕" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Margin="1130,0,36,666"
                            Background="Transparent" FontSize="16" Cursor="Hand" BorderThickness="0"
                            Command="{Binding MinimizeCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="—" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>


            <!-- Оверлей теперь сверху, с небольшим отступом от края -->
            <controls:NotificationOverlay 
                Panel.ZIndex="2000"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"/>


        </Grid>
    </Border>
</Window>
