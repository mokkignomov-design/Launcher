<Window x:Class="Runia.Ui.Windows.UpdateStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="96"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize">
    <Border Padding="16,12"
            CornerRadius="14"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource AccentBrush}" />
                <TextBlock Text="RUNIA LAUNCHER"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GrayBrush}" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="18,8,0,0"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}"
                       Text="Проверяем обновления..." />
            <ProgressBar Grid.Row="1"
                         Height="2"
                         Margin="18,30,0,0"
                         IsIndeterminate="True"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource DarkGrayBrush}"
                         BorderThickness="0" />
        </Grid>
    </Border>
</Window>
