<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ControlTemplate x:Key="BaseButtonTemplate" TargetType="Button">
        <Border x:Name="mainBorder" CornerRadius="{StaticResource ControlCornerRadius}"
             Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ButtonBorderBrush}" 
             BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="mainBorder" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="BaseIOSToggleTemplate" TargetType="ToggleButton">
        <Grid Cursor="Hand">
            <Border x:Name="TrackOff" Background="{TemplateBinding Background}" 
                 CornerRadius="{StaticResource ControlCornerRadiusLarge}" Width="52" Height="32"/>
            <Border x:Name="TrackOn" Background="{TemplateBinding Tag}" 
                 CornerRadius="{StaticResource ControlCornerRadiusLarge}" Width="52" Height="32" Opacity="0"/>
            <Ellipse x:Name="Thumb" Width="28" Height="28" Fill="{TemplateBinding Foreground}" 
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="22,0,0,0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="2,0,0,0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Базовый стиль для Radio (нужен для BasedOn) -->
    <Style x:Key="BaseNavRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>